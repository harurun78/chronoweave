{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "debug: start app (Vite)",
            "type": "npm",
            "script": "dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*VITE v",
                    "endsPattern": "^\\s*(Local:|Network:)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "runOptions": {
                "reevaluateOnRerun": true
            }
        },
        {
            "label": "debug: preview production build",
            "type": "npm",
            "script": "preview",
            "isBackground": true,
            "dependsOn": ["build"],
            "problemMatcher": {
                "owner": "vite-preview",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*➜|^\\s*Local:",
                    "endsPattern": "^\\s*(Local:|Network:)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "label": "lint",
            "type": "npm",
            "script": "lint",
            "problemMatcher": ["$eslint-stylish"],
            "group": "build"
        },
        {
            "label": "type-check",
            "type": "npm",
            "script": "type-check",
            "problemMatcher": ["$tsc"],
            "group": "build"
        },
        {
            "label": "test: unit and integration",
            "type": "npm",
            "script": "test:run",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "test: ui integration",
            "type": "npm",
            "script": "test:integration",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "test: e2e",
            "type": "npm",
            "script": "test:e2e",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "format: check",
            "type": "npm",
            "script": "format:check",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "format: write",
            "type": "npm",
            "script": "format",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "build",
            "type": "npm",
            "script": "build",
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "audit",
            "type": "shell",
            "command": "npm audit",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "verify: full local gate",
            "dependsOrder": "sequence",
            "dependsOn": [
                "lint",
                "type-check",
                "test: unit and integration",
                "test: e2e",
                "format: check",
                "build",
                "audit"
            ],
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
