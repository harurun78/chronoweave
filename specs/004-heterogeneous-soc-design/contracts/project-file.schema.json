{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoweave.local/schemas/project-file-v0.3.schema.json",
  "title": "Chronoweave ProjectFile v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "global", "domains", "tasks"],
  "properties": {
    "version": { "const": "0.3" },
    "global": { "$ref": "#/$defs/globalSettings" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/domain" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskFile" }
    },
    "aperiodic_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/aperiodicTaskFile" },
      "default": []
    },
    "sporadic_server": { "$ref": "#/$defs/sporadicServerConfig" },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel" },
      "default": []
    },
    "stochastic_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/stochasticEventSource" },
      "default": []
    },
    "codegen": { "$ref": "#/$defs/codegenSettings" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "stackPresetName": { "enum": ["low", "mid", "high"] },
    "priorityMode": { "enum": ["auto", "manual"] },
    "domainKind": { "enum": ["baremetal", "rtos", "linux", "fpga"] },
    "transportKind": { "enum": ["shared_memory", "mailbox", "queue"] },

    "globalSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick_ms", "stack_presets"],
      "properties": {
        "tick_ms": { "type": "number", "exclusiveMinimum": 0 },
        "stack_presets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "mid", "high"],
          "properties": {
            "low":  { "type": "integer", "exclusiveMinimum": 0 },
            "mid":  { "type": "integer", "exclusiveMinimum": 0 },
            "high": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        "ram_capacity": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },

    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "core_count"],
      "properties": {
        "id":          { "$ref": "#/$defs/identifier" },
        "name":        { "type": "string", "minLength": 1 },
        "kind":        { "$ref": "#/$defs/domainKind" },
        "core_count":  { "type": "integer", "minimum": 1 },
        "description": { "type": "string" }
      }
    },

    "taskFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "period_ms", "wcet_ms", "stack", "domain_id"],
      "properties": {
        "id":              { "$ref": "#/$defs/identifier" },
        "name":            { "type": "string", "minLength": 1 },
        "period_ms":       { "type": "number", "exclusiveMinimum": 0 },
        "wcet_ms":         { "type": "number", "exclusiveMinimum": 0 },
        "deadline_ms":     { "type": "number", "exclusiveMinimum": 0 },
        "priority_mode":   { "$ref": "#/$defs/priorityMode" },
        "manual_priority": { "type": "integer" },
        "stack":           { "$ref": "#/$defs/stackPresetName" },
        "domain_id":       { "$ref": "#/$defs/identifier" },
        "core_index":      { "type": "integer", "minimum": 0 },
        "description":     { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "priority_mode": { "const": "manual" } },
            "required": ["priority_mode"]
          },
          "then": { "required": ["manual_priority"] }
        }
      ]
    },

    "aperiodicTaskFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "wcet_ms", "stack", "domain_id"],
      "properties": {
        "id":          { "$ref": "#/$defs/identifier" },
        "name":        { "type": "string", "minLength": 1 },
        "wcet_ms":     { "type": "number", "exclusiveMinimum": 0 },
        "deadline_ms": { "type": "number", "exclusiveMinimum": 0 },
        "stack":       { "$ref": "#/$defs/stackPresetName" },
        "domain_id":   { "$ref": "#/$defs/identifier" },
        "description": { "type": "string" }
      }
    },

    "sporadicServerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "budget_ms", "period_ms", "stack", "domain_id"],
      "properties": {
        "enabled":         { "type": "boolean" },
        "budget_ms":       { "type": "number", "exclusiveMinimum": 0 },
        "period_ms":       { "type": "number", "exclusiveMinimum": 0 },
        "deadline_ms":     { "type": "number", "exclusiveMinimum": 0 },
        "priority_mode":   { "$ref": "#/$defs/priorityMode" },
        "manual_priority": { "type": "integer" },
        "stack":           { "$ref": "#/$defs/stackPresetName" },
        "domain_id":       { "$ref": "#/$defs/identifier" },
        "core_index":      { "type": "integer", "minimum": 0 }
      }
    },

    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "producer_task_id", "consumer_task_id", "transport", "latency_budget_ms"],
      "properties": {
        "id":                 { "$ref": "#/$defs/identifier" },
        "producer_task_id":   { "$ref": "#/$defs/identifier" },
        "consumer_task_id":   { "$ref": "#/$defs/identifier" },
        "transport":          { "$ref": "#/$defs/transportKind" },
        "latency_budget_ms":  { "type": "number", "exclusiveMinimum": 0 },
        "description":        { "type": "string" }
      }
    },

    "stochasticEventSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain_id", "mean_interarrival_ms", "consumer_task_id"],
      "properties": {
        "id":                   { "$ref": "#/$defs/identifier" },
        "name":                 { "type": "string", "minLength": 1 },
        "domain_id":            { "$ref": "#/$defs/identifier" },
        "mean_interarrival_ms": { "type": "number", "exclusiveMinimum": 0 },
        "std_dev_ms":           { "type": "number", "minimum": 0 },
        "consumer_task_id":     { "$ref": "#/$defs/identifier" },
        "description":          { "type": "string" }
      }
    },

    "codegenSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin"],
      "properties": {
        "plugin":    { "const": "freertos" },
        "namespace": { "type": "string", "minLength": 1 }
      }
    }
  }
}
